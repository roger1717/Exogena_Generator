# ============================================================================
#  Plantilla de variables de entorno
# ============================================================================
#  Copia este archivo como ".env" y rellena los valores.
#  El .env real nunca se sube al repositorio; este ejemplo si, para que se
#  sepa que claves hacen falta al instalar el proyecto en otro computador.
#
#    cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
#  0) BASE DE DATOS  ->  Postgres alojado en Supabase (supabase.com)
# ---------------------------------------------------------------------------
#  Sacala en tu proyecto de Supabase: Project Settings -> Database ->
#  Connection string -> modo "Transaction pooler" (puerto 6543). Reemplaza
#  [YOUR-PASSWORD] por la contrasena que definiste al crear el proyecto.
#  Ejemplo de forma (no es una clave real):
#  postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Clave de Resend (https://resend.com -> API Keys). Empieza por "re_".
RESEND_API_KEY=

# Correo donde quieres recibir el aviso de cada solicitud.
MAIL_TO=

# Remitente. Para pruebas: Automat-IA <onboarding@resend.dev>
# En produccion, una direccion del dominio verificado en Resend.
MAIL_FROM=Automat-IA <hola@automat-ia.com.co>

# Clave para entrar al panel privado (/api/leads y /api/stats).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_KEY=
